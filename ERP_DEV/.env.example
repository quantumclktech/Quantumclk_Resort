# Copy the names you need into ERP_DEV/.env (git-ignored) and fill in your own values.
# Never commit real values. Generate each secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433
KC_DB_PASSWORD=
ACCESS_DB_PASSWORD=
# guest-service database login (guest_db; created by infra/postgres/init on a fresh volume)
GUEST_DB_PASSWORD=
# lead-service database login (lead_db; created by infra/postgres/init on a fresh volume)
LEAD_DB_PASSWORD=

# --- Keycloak ---
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_ACCESS_SERVICE_CLIENT_SECRET=
# Realm gh-guests: guest-service's client secret (any long random string, e.g. openssl rand -hex 24)
KC_GUEST_SERVICE_CLIENT_SECRET=
# One public origin for everything (D-124): with the tunnel, set ERP_WEB_ORIGIN, KC_PUBLIC_URL and
# KEYCLOAK_URL to the same https://<public host>, and ERP_WEB_URL to https://<public host>/erp/.
# The tunnel points at the path proxy: ngrok http 8088 --url=<public host> (infra/proxy/Caddyfile).
# ERP_WEB_ORIGIN: scheme + host only (Keycloak web origin, realm import).
ERP_WEB_ORIGIN=http://localhost:5173
# ERP_WEB_URL: the staff ERP's full URL; the staff setup email returns here after the password is set.
ERP_WEB_URL=http://localhost:5173/erp/
# Landing page public origin: Keycloak gh-guests redirect URIs / web origins and the member welcome-email link.
# With the tunnel: the same https://<public host> as above (the landing page is served at "/").
LANDING_PUBLIC_URL=http://localhost:3000
# Base URL Keycloak puts in invite/reset emails and in tokens. Use the host the BROWSER can reach.
# Desktop only: http://localhost:8081. Phone/anywhere: the public HTTPS hostname (e.g. an ngrok dev domain).
# Fails on phones without HTTPS: browsers hide the Web Crypto API that PKCE needs (see KEYCLOAK-SETUP §1).
KC_PUBLIC_URL=http://localhost:8081
KEYCLOAK_BIND=127.0.0.1
# KEYCLOAK_URL: the issuer the services validate (must equal KC_PUBLIC_URL unless you also change the token iss).
KEYCLOAK_URL=http://localhost:8081
# Optional: internal address for Admin API calls, so provisioning does not depend on the public hostname.
# KEYCLOAK_ADMIN_URL=http://localhost:8081
# Browser origins allowed to call the gateway (comma-separated, no spaces).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SMTP for Keycloak emails (defaults go to the local Mailpit; staging/prod: Q-024) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@goldenhills.local
SMTP_REPLY_TO=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# --- Redis (api-gateway rate limits) ---
REDIS_PASSWORD=

# --- access-service: first ADMIN, used only while no ADMIN exists (KEYCLOAK-SETUP §10) ---
# Gold Membership (access-service): payment-screenshot storage. The key is 32 random bytes, base64:
#   openssl rand -base64 32
# Required for Scan-QR registrations. Never commit it; losing it makes the stored screenshots unreadable.
MEMBERSHIP_PROOF_KEY=
# Gold Member ID proof (D-131): key for the keyed hash (HMAC-SHA256) that blocks a second live membership for the
# same Aadhaar / licence. At least 32 random bytes, base64 (openssl rand -base64 32). Required for registration.
# Never commit it; changing it later stops duplicate detection against members already registered.
MEMBERSHIP_ID_HASH_KEY=
# Optional: where the encrypted files go (default ./data/membership-proofs, relative to access-service; git-ignored).
# MEMBERSHIP_PROOF_DIR=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_MOBILE=
