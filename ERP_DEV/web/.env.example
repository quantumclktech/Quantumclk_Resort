# Copy to web/.env.local if you need different values. These are not secrets (a public SPA client).
# Leave VITE_API_URL and VITE_KEYCLOAK_URL EMPTY: the app then uses the address it was opened on (localhost, the
# ngrok tunnel or the VPS), because /realms and /api are proxied on that same origin (Caddy / vite.config.ts, D-124).
# Never put a tunnel or server hostname here: VITE_* values are baked into the build, so a copied file sends every
# request to that old host. Set them only if the API or Keycloak really run on a different host.
VITE_API_URL=
VITE_KEYCLOAK_URL=
# Extra hostnames the Vite DEV server accepts (comma-separated), e.g. erp.example.com. *.ngrok-free.dev is built in.
VITE_ALLOWED_HOSTS=
VITE_KEYCLOAK_REALM=gh-staff
VITE_KEYCLOAK_CLIENT_ID=erp-web
# Gold Membership "Scan QR": the resort's official UPI QR image (client to supply, Q-031). Put the file in
# web/public/ and give its path, e.g. /erp/upi-qr.png. Empty = a "QR not configured" note is shown.
VITE_UPI_QR_URL=
# Gold Member form: one-tap amounts, comma-separated rupees (e.g. 25000,30000,50000). Leave empty until the client
# confirms the Gold fee (Q-030): no chips are shown then. Never a guessed price.
VITE_GOLD_FEE_CHIPS=
