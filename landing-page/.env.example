# Golden Hills Resort - Landing Page (Design-1) Environment. All optional; the defaults work locally and on the
# shared public URL (ERP_DEV/infra/proxy/Caddyfile).

# Portal API base. Default: same origin "/api/v1/portal" (the proxy, or next.config.ts on localhost:3000, sends /api
# to the gateway). Don't set an http://localhost:8082 URL here: phones on the public URL can't reach it.
# NEXT_PUBLIC_LEAD_API_URL=/api/v1/portal

# Where next.config.ts sends /api on plain http://localhost:3000 (server side only).
# GATEWAY_URL=http://localhost:8082

# Member sign-in (Keycloak realm gh-guests, client guest-web; ERP_DEV/docs/02-architecture/identity/MEMBER-LOGIN.md).
# Default: the site's own origin, or http://localhost:8081 when the site runs on localhost:3000.
# NEXT_PUBLIC_KEYCLOAK_URL=
# NEXT_PUBLIC_KEYCLOAK_REALM=gh-guests
# NEXT_PUBLIC_KEYCLOAK_CLIENT=guest-web
